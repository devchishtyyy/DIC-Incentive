<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy for the DIC Production Incentive app.

  Both rules point at port 6004 because this app serves its API and its frontend from the
  same Node process - /api/* is handled by the server and everything else is the built
  page. The two rules are kept separate anyway so the API can be split onto its own port
  later by changing one line.

  Needs the IIS URL Rewrite and Application Request Routing modules, and ARR's proxy
  setting switched on:
      %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/proxy /enabled:"True" /commit:apphost
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="API Backend" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:6004/api/{R:1}" />
        </rule>
        <rule name="Frontend" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:6004/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Pass the real client address through, so the sign-in throttle counts the person
         in front of IIS and not IIS itself. Without this every user shares one budget. -->
    <proxy preserveHostHeader="true" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- The app holds no files of its own, so nothing here should be browsable. -->
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
