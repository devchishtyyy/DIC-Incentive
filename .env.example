# SAP SuccessFactors — copy to .env.local and fill in. .env.local is gitignored.
#
# Everything here can also be typed into Master Data → Import from SAP; the file only
# saves retyping the private key each time. These are read by the Vite dev server, so
# restart `npm run dev` after changing them.

# Your company's API server — printed in Admin Center under "API Server Address".
SF_API_SERVER=https://api44.sapsf.com

# From Admin Center → Manage OAuth2 Client Applications.
SF_CLIENT_ID=
SF_COMPANY_ID=packagesli

# The SuccessFactors user the access token acts as.
SF_USER_ID=ECAdmin

# The X.509 private key registered against that OAuth client.
#
# WARNING: this key signs assertions for ANY user in the tenant, not just the one above.
# Treat it like a root password. Never commit it, never paste it into a chat or a ticket.
# If it is ever exposed, regenerate the client in Admin Center immediately.
SF_PRIVATE_KEY=

# The Emp ID range to pull.
SF_FROM_USER_ID=40000000
SF_TO_USER_ID=40009999

# Last resort if the corporate root CA cannot be trusted — see certs/README.md.
# Skips TLS verification for the proxy's hop to SAP only. Prefer fixing the certificate.
# SF_INSECURE_TLS=true
