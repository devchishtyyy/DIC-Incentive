node_modules

# dist/ and backend/server.js ARE committed, deliberately.
#
# Both are build output, and committing build output is normally wrong. It is right here
# because the server deploys by `git pull` and nothing else: leaving them out meant a pull
# produced a tree PM2 could not start ("Script not found: backend\server.js") and a
# frontend with nothing to serve. The other apps on this box commit their builds for the
# same reason. Run `npm run build` before committing so what ships matches the source.
.vite
*.local
.DS_Store

# Live staff data pulled from SAP — never commit this
sap-users.json
src/data/sap-users.json
*.sap.json

# Credentials
.env
.env.local
*.key
*.pem

# Corporate CA certificates — specific to one network, not to the project
certs/*
!certs/README.md
logs/
